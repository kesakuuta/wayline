import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct ServerItem {
    id: string,
    name: string,
    protocol: string,
    transport: string,
    flag: string,
    ping: string,
    selected: bool,
}

export struct SubscriptionItem {
    id: string,
    name: string,
    count: int,
    active: bool,
}

export component MainWindow inherits Window {
    title: "Wayline VPN";
    min-width: 900px;
    min-height: 620px;
    preferred-width: 1080px;
    preferred-height: 720px;
    background: #0B0C10;

    in-out property <bool> connected: false;
    in-out property <bool> connecting: false;
    in-out property <string> core-engine: "sing-box";
    in-out property <string> active-sub-name: "Локальные профили";
    in-out property <int> active-sub-count: 0;
    in-out property <string> selected-server-name: "Сервер не выбран";
    in-out property <string> selected-server-meta: "Выберите сервер слева";
    in-out property <string> status-text: "Отключено · Туннель неактивен";
    in-out property <[SubscriptionItem]> subscriptions: [];
    in-out property <[ServerItem]> servers: [];

    callback connect-toggled();
    callback select-server(string);
    callback select-subscription(string);
    callback ping-all();
    callback open-import();
    callback open-settings();

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // Topbar
        Rectangle {
            height: 52px;
            background: #11141D;
            border-bottom-width: 1px;
            border-color: #2A3040;

            HorizontalBox {
                padding-left: 20px;
                padding-right: 20px;
                alignment: space-between;

                // Brand
                HorizontalBox {
                    spacing: 10px;
                    alignment: start;

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: #6366F1.transparentize(0.8);

                        Text {
                            text: "🛡";
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "WAYLINE";
                        color: #F8FAFC;
                        font-size: 16px;
                        font-weight: 700;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        height: 18px;
                        border-radius: 4px;
                        background: #1F2430;
                        padding-left: 6px;
                        padding-right: 6px;

                        Text {
                            text: "v0.2";
                            color: #94A3B8;
                            font-size: 10px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                // Actions
                HorizontalBox {
                    spacing: 12px;
                    alignment: end;

                    Rectangle {
                        height: 28px;
                        border-radius: 14px;
                        background: #161922;
                        border-width: 1px;
                        border-color: #2A3040;
                        padding-left: 10px;
                        padding-right: 10px;

                        HorizontalBox {
                            spacing: 6px;
                            alignment: center;

                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: root.connected ? #10B981 : #94A3B8;
                            }

                            Text {
                                text: root.core-engine;
                                color: #F8FAFC;
                                font-size: 12px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        background: #161922;
                        border-width: 1px;
                        border-color: #2A3040;

                        Text {
                            text: "⚙";
                            color: #94A3B8;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => { root.open-settings(); }
                        }
                    }
                }
            }
        }

        // Two-pane workspace
        HorizontalBox {
            padding: 16px;
            spacing: 16px;

            // Left Pane: Subscriptions and Server List
            Rectangle {
                width: 480px;
                background: #11141D;
                border-radius: 12px;
                border-width: 1px;
                border-color: #2A3040;

                VerticalBox {
                    padding: 16px;
                    spacing: 12px;

                    // Subscription Tabs Row
                    HorizontalBox {
                        spacing: 8px;
                        alignment: start;

                        for sub in root.subscriptions: Rectangle {
                            height: 32px;
                            border-radius: 16px;
                            background: sub.active ? #1F2430 : #161922;
                            border-width: 1px;
                            border-color: sub.active ? #6366F1 : #2A3040;
                            padding-left: 12px;
                            padding-right: 12px;

                            HorizontalBox {
                                spacing: 6px;
                                alignment: center;

                                Text {
                                    text: sub.active ? "◆" : "◇";
                                    color: sub.active ? #38BDF8 : #94A3B8;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: sub.name;
                                    color: sub.active ? #F8FAFC : #94A3B8;
                                    font-size: 13px;
                                    font-weight: sub.active ? 600 : 400;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: sub.count;
                                    color: #94A3B8;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                clicked => { root.select-subscription(sub.id); }
                            }
                        }

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: #161922;
                            border-width: 1px;
                            border-color: #2A3040;

                            Text {
                                text: "+";
                                color: #F8FAFC;
                                font-size: 16px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => { root.open-import(); }
                            }
                        }
                    }

                    // Active Subscription Card (NO THREE DOTS)
                    Rectangle {
                        height: 70px;
                        background: #161922;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #2A3040;

                        HorizontalBox {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: space-between;

                            VerticalBox {
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: "АКТИВНАЯ ПОДПИСКА";
                                    color: #94A3B8;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                }

                                Text {
                                    text: root.active-sub-name;
                                    color: #F8FAFC;
                                    font-size: 15px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: root.active-sub-count + " серверов";
                                    color: #94A3B8;
                                    font-size: 11px;
                                }
                            }

                            HorizontalBox {
                                spacing: 8px;
                                alignment: center;

                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: #1F2430;

                                    Text {
                                        text: "⚡";
                                        font-size: 14px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => { root.ping-all(); }
                                    }
                                }

                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: #1F2430;

                                    Text {
                                        text: "↻";
                                        font-size: 16px;
                                        color: #94A3B8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => { /* refresh */ }
                                    }
                                }
                            }
                        }
                    }

                    // Server List
                    ScrollView {
                        VerticalBox {
                            spacing: 6px;
                            padding: 0px;

                            for s in root.servers: Rectangle {
                                height: 48px;
                                border-radius: 8px;
                                background: s.selected ? #1F2430 : #161922;
                                border-width: 1px;
                                border-color: s.selected ? #6366F1 : #2A3040;

                                HorizontalBox {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: space-between;

                                    HorizontalBox {
                                        spacing: 10px;
                                        alignment: center;

                                        Text {
                                            text: s.flag;
                                            font-size: 18px;
                                            vertical-alignment: center;
                                        }

                                        VerticalBox {
                                            alignment: center;
                                            spacing: 1px;

                                            Text {
                                                text: s.name;
                                                color: #F8FAFC;
                                                font-size: 13px;
                                                font-weight: 500;
                                            }

                                            Text {
                                                text: s.protocol + " · " + s.transport;
                                                color: #94A3B8;
                                                font-size: 10px;
                                            }
                                        }
                                    }

                                    HorizontalBox {
                                        spacing: 8px;
                                        alignment: center;

                                        Text {
                                            text: s.ping;
                                            color: #10B981;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }

                                        Rectangle {
                                            width: 16px;
                                            height: 16px;
                                            border-radius: 8px;
                                            border-width: 1.5px;
                                            border-color: s.selected ? #38BDF8 : #2A3040;

                                            Rectangle {
                                                width: 8px;
                                                height: 8px;
                                                border-radius: 4px;
                                                background: s.selected ? #38BDF8 : transparent;
                                                x: 4px;
                                                y: 4px;
                                            }
                                        }
                                    }
                                }

                                TouchArea {
                                    clicked => { root.select-server(s.id); }
                                }
                            }
                        }
                    }
                }
            }

            // Right Pane: Main Connect Stage & Selected Server
            Rectangle {
                background: #11141D;
                border-radius: 12px;
                border-width: 1px;
                border-color: #2A3040;

                VerticalBox {
                    padding: 24px;
                    alignment: space-between;

                    // Protection status chip
                    HorizontalBox {
                        alignment: end;

                        Rectangle {
                            height: 28px;
                            border-radius: 14px;
                            background: #161922;
                            border-width: 1px;
                            border-color: #2A3040;
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: "TUN · весь трафик";
                                color: #38BDF8;
                                font-size: 12px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Main Power Button with Halo
                    VerticalBox {
                        alignment: center;
                        spacing: 16px;

                        Rectangle {
                            width: 120px;
                            height: 120px;
                            border-radius: 60px;
                            background: root.connected ? #10B981 : #6366F1;

                            Text {
                                text: "⏻";
                                font-size: 52px;
                                color: #FFFFFF;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => { root.connect-toggled(); }
                            }
                        }

                        Text {
                            text: root.connecting ? "ПОДКЛЮЧАЮ…" : root.connected ? "ОТКЛЮЧИТЬ" : "ПОДКЛЮЧИТЬ";
                            color: #F8FAFC;
                            font-size: 16px;
                            font-weight: 700;
                            letter-spacing: 1px;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.status-text;
                            color: #94A3B8;
                            font-size: 12px;
                            horizontal-alignment: center;
                        }
                    }

                    // Selected Server Card
                    Rectangle {
                        height: 64px;
                        background: #161922;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #2A3040;

                        HorizontalBox {
                            padding-left: 16px;
                            padding-right: 16px;
                            alignment: space-between;

                            HorizontalBox {
                                spacing: 12px;
                                alignment: center;

                                Text {
                                    text: "🌐";
                                    font-size: 24px;
                                    vertical-alignment: center;
                                }

                                VerticalBox {
                                    alignment: center;
                                    spacing: 2px;

                                    Text {
                                        text: root.selected-server-name;
                                        color: #F8FAFC;
                                        font-size: 14px;
                                        font-weight: 600;
                                    }

                                    Text {
                                        text: root.selected-server-meta;
                                        color: #94A3B8;
                                        font-size: 11px;
                                    }
                                }
                            }

                            Rectangle {
                                height: 20px;
                                border-radius: 4px;
                                background: #1F2430;
                                padding-left: 8px;
                                padding-right: 8px;

                                Text {
                                    text: "ВЫБРАН";
                                    color: #38BDF8;
                                    font-size: 10px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
